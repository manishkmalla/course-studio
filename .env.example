# Copy to .env only if you need to run api/web commands on the host
# (outside Docker). docker compose up --build works without this file;
# it uses the defaults baked into docker-compose.yml.

# --- api ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://course_studio:course_studio@localhost:5432/course_studio
TEST_DATABASE_URL=postgres://course_studio:course_studio@localhost:5432/course_studio_test
JWT_SECRET=dev-only-secret-change-me-please-32chars
WEB_ORIGIN=http://localhost:5173

# --- web ---
API_PROXY_TARGET=http://localhost:3000
